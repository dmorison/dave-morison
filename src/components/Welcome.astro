---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import dataImage from '../assets/data-image.png';
import performanceImage from '../assets/performance-image.png';
import NavBar from './NavBar.astro';
import Hero from './Hero.astro';
import Tech from './Tech.astro';
import ContactForm from './ContactForm.astro';
---

<div id="container">
	<main>
		<NavBar page="homePage" />
		<div class="content">
			<section id="hero">
				<Hero />
			</section>
			<section id="pitch">
				<h3>Technical Edge</h3>
				<div class="cards-wrapper">
					<div class="card card-one">
						<p>I'll take care of the technical implementation, helping you make strategic business decisions based on accurate data.</p>
						<p>With a background in web development and a passion for data, I bridge the gap between technical implementation and business insights.</p>
						<a href="/dave-morison/about" id="about-me-link-btn" class="about-me">More about me</a>
					</div>
					<div class="card">
						<div class="card-inner">
							<div>
								<h4>Clean Data</h4>
								<p>I write custom scripts to get the data you need, ensuring accuracy and reliability.</p>
							</div>
							<Image src={dataImage} alt="Google Analytics dashboard" width={250} />
						</div>
					</div>
					<div class="card">
						<div class="card-inner">
							<div>
								<h4>Performance</h4>
								<p>I implement lean tagging, so that tracking doesn't affect your website's performance.</p>
							</div>
							<Image src={performanceImage} alt="Google Analytics dashboard" width={250} />
						</div>
					</div>
				</div>
			</section>
			<section id="services">
				<h3>Services</h3>
				<div class="cards-wrapper">
					<div class="card service-card">
						<div>
							<h4>The Audit</h4>
							<p>Focuses on a systematic review of your existing setup.</p>
						</div>
						<p><a href="/dave-morison/services#audit" id="services-audit-learn-more" class="service-btn">Learn More<Icon name="arrowRight" size="20" /></a></p>
					</div>
					<div class="card service-card">
						<div>
							<h4>The Foundation</h4>
							<p>Focuses on base implementation and measurement planning.</p>
						</div>
						<p><a href="/dave-morison/services#foundation" id="services-foundation-learn-more" class="service-btn">Learn More<Icon name="arrowRight" size="20" /></a></p>
					</div>
					<div class="card service-card">
						<div>
							<h4>The Explorer</h4>
							<p>Collect additional information that Google Analytics does not collect automatically and create custom reports using advanced techniques.</p>
						</div>
						<p><a href="/dave-morison/services#explorer" id="services-explorer-learn-more" class="service-btn">Learn More<Icon name="arrowRight" size="20" /></a></p>
					</div>
					<div class="card service-card">
						<div>
							<h4>Ongoing Support</h4>
							<p>Focuses on providing monthly technical support and maintenance.</p>
						</div>
						<p><a href="/dave-morison/services#support" id="services-support-learn-more" class="service-btn">Learn More<Icon name="arrowRight" size="20" /></a></p>
					</div>
					<!-- <div class="card">
						<h4>The Visualization</h4>
						<p><strong>Custom dashboards</strong></p>
						<ul>
							<li><Icon name="check" size="20" />Looker Studio</li>
							<li><Icon name="check" size="20" />Tableau</li>
							<li><Icon name="check" size="20" />Power BI</li>
						</ul>
					</div> -->
				</div>
			</section>
			<section id="tech">
				<h3>Tech Stack</h3>
				<Tech />
			</section>
		</div>
		<section id="contact">
			<div class="contact-inner">
				<h3>Contact</h3>
				<ContactForm />
			</div>
		</section>
	</main>
</div>

<style>
	#container {
		font-family: var(--font-montserrat), Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #012C3C;
	}

	.content {
		height: 100%;
		background: linear-gradient(to bottom, #9BC0DA, #ffffff);
	}

	section {
		padding: 6em 1em 1em;
	}
	section#hero {
		padding-top: 1em;
	}

	#services .card {
		background-color: #ffffff;
	}

	#tech {
		text-align: center;
	}

	#contact{
		display: flex;
		justify-content: center;
		background-color: #1B5B7E;
		color: #E8F5FD;
	}

	.contact-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-around;
		padding: 1em;
	}

	h3 {
		font-size: 23px;
		margin-top: 0;
	}

	h4 {
		margin-top: 0;
		margin-bottom: 0.5em;
		text-decoration: underline;
	}

	p {
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	.cards-wrapper {
		display: flex;
		flex-direction: column;
		gap: 2em;
		margin: 1em 0;
	}

	.card {
		flex: 1;
		background-color: #E8F5FD;
		padding: 1em;
		border-radius: 8px;
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	}

	.card-inner {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		text-align: center;
	}

	.card-inner > div {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.card-one {
		max-width: 300px;
		background-color: transparent;
		padding-left: 0;
		padding-bottom: 0;
		box-shadow: none;
	}
	.card-one p:first-child {
		margin-bottom: 1em;
	}

	.service-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.service-card svg {
		position: relative;
		top: 5px;
		left: 4px;
		transition: transform 300ms ease;
	}
	.service-card:hover svg {
		transform: translateX(5px);
	}

	.about-me {
		display: inline-block;
		margin-top: 1em;
		padding: 0.75em 1.5em;
		background-color: #1B5B7E;
		color: #ffffff;
		font-weight: bold;
		text-decoration: none;
		border-radius: 2em;
		font-size: 16px;
		border: none;
		transition: background-color 300ms ease, color 300ms ease;
	}
	.about-me:hover {
		background-color: #ffffff;
		color: #1B5B7E;
	}

	@media screen and (min-width: 768px) {
		section {
			padding: 6em 4em 2em;
		}
		section#hero {
			padding-top: 4em;
		}

		#pitch, #services {
			max-width: 1400px;
			margin: 0 auto;
		}

		.contact-inner {
			width: 500px;
		}

		.cards-wrapper {
			flex-direction: row;
			gap: 2em;
			margin: 1em 0;
		}

		.card-inner {
			flex-direction: row;
			text-align: left;
		}

		.card-inner > div {
			align-items: flex-start;
		}
	}
</style>

