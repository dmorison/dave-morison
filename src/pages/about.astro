---
import Layout from '../layouts/Layout.astro';
import ContactForm  from '@/components/ContactForm.astro';
import NavBar from '@/components/NavBar.astro';
import { Image } from 'astro:assets';
import aboutImage from '../assets/about-image.jpg';
import googleAnalyticsBadge from '../assets/google-analytics-certified-badge.png';
---

<Layout title="About Me">
    <div id="container">
        <main>
            <NavBar page="aboutPage" />
            <div class="content">
                <section>
                    <Image src={aboutImage} alt="About Dave Morison" class="about-image" width="300" />
                    <div>
                        <h1>About Me</h1>
                        <p>I'm a UK based Digital Analytics Consultant dedicated to helping small to medium-sized business owners eliminate data blind spots and extract clear insights from their data using Google Analytics 4 (GA4) and Google Tag Manager (GTM).</p>
                        <p>I implement developer-grade tracking solutions that ensure the most important clicks and conversions are accounted for to help business owners make better decisions and achieve their objectives.</p>
                        <p>I have 12 years of experience as a web developer including 11 years working for MoneySavingExpert.com which is one of the most trusted, high-traffic websites in the UK.</p>
                        <p>My deep technical understanding of websites enables me to write custom code, configure precise data layers and implement efficient tracking solutions.</p>
                        <!-- <p>During my time at MoneySavingExpert.com, along with my development responsibilities, I also took on analytics-related tasks. I helped implement tracking solutions for both developer needs and business stakeholders.</p> -->
                        <p>When I'm not working on analytics projects, you can find me mostly outdoors doing various activities from walking my dogs to hiking, cycling or swimming. Otherwise I'll be relaxing and enjoying a good book.</p>
                        <p><a href="/dave-morison/services" id="about-page-services-link-btn" class="services-btn">Find out more about the services I offer</a></p>
                        <a href="https://skillshop.credential.net/50511e36-5343-454f-a398-4dfc4b03d6e9#acc.ZUifNMlk" target="_blank" rel="noopener noreferrer">
                            <Image src={googleAnalyticsBadge} alt="Google Analytics Certified Badge" width="150" />
                        </a>
                    </div>
                </section>
            </div>
            <section id="contact">
			    <div class="contact-inner">
                    <h3>Contact</h3>
                    <ContactForm />
                </div>
		    </section>
        </main>
    </div>
</Layout>

<style>
    #container {
		font-family: var(--font-montserrat), Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #012C3C;
	}

	.content {
		height: 100%;
		background: linear-gradient(to bottom, #9BC0DA, #ffffff);
	}

	section {
        display: flex;
        justify-content: center;
        gap: 1em;
        flex-wrap: wrap;
		padding: 1em;
        max-width: 1100px;
        margin: 0 auto;
	}

    section#contact {
        padding-top: 3em;
        background-color: #1B5B7E;
		color: #E8F5FD;
        max-width: 100%;
    }

    p {
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
	}

	.contact-inner {
		display: flex;
		flex-direction: column;
		justify-content: space-around;
		padding: 1em;
	}

    .about-image {
        border: 2px solid #012C3C;
        border-radius: 10em;
        margin-top: 1em;
    }
    
    .services-btn {
		display: inline-block;
		margin-top: 1em;
        margin-bottom: 1em;
		padding: 0.75em 1.5em;
		background-color: #1B5B7E;
		color: #ffffff;
		font-weight: bold;
		text-decoration: none;
		border-radius: 2em;
		font-size: 15px;
		border: none;
		transition: background-color 300ms ease, color 300ms ease;
	}
	.services-btn:hover {
		background-color: #ffffff;
		color: #1B5B7E;
	}

    @media screen and (min-width: 768px) {
        section {
			padding: 4em;
            flex-wrap: nowrap;
            gap: 2em;
		}

        .contact-inner {
			width: 500px;
		}

        .services-btn {
            font-size: 16px;
        }
    }
</style>
